#!/bin/sh

# Run command based on argument
case "$1" in
    up) output="$(brightnessctl -m set +5%)" || exit 1 ;;
    down) output="$(brightnessctl -m set 5%-)" || exit 1 ;;
    *) output="$(brightnessctl -m)" || exit 1 ;;
esac

# Get brightness percent
brightness="${output%,*}"
brightness="${brightness##*,}"
brightness="${brightness%\%}"

# Set notification icon
icon="video-display"

# Get unique id for notification replacement
checksum="$(printf '%s' "${0##*/}" | sum)"
notify_id="${checksum%% *}"

# Send notification
notify-send "Brightness: ${brightness}%" -h int:value:"${brightness}" -i "${icon}" -r "${notify_id}" -t 2000 -u normal
