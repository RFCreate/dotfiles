#!/bin/sh

WARNING_LEVEL=30
CRITICAL_LEVEL=15

# Get first battery occurance
battery_dir=""
for candidate in /sys/class/power_supply/BAT*; do
    if [ -d "$candidate" ]; then
        battery_dir="$candidate"
        break
    fi
done
unset candidate
# Exit if match is not found
[ -n "$battery_dir" ] || exit 1

last_battery_status="Unknown"
battery_status="Unknown"
battery_capacity="0"
urgency="normal"
last_icon=""
icon=""

# Get unique id for notification replacement
notify_id="$$"

# Send notification
send_notification() {
    notify-send "${battery_status} battery: ${battery_capacity}%" -i "${icon}" -r "${notify_id}" -u "${urgency}" || exit 1
}

# Save current status
save_status() {
    last_battery_status="$battery_status"
}

# Save current icon
save_icon() {
    last_icon="$icon"
}

# Check if last and current status are different
is_diff_status() {
    [ "$battery_status" != "$last_battery_status" ]
}

# Check if last and current icon are different
is_diff_icon() {
    [ "$icon" != "$last_icon" ]
}

# Set icon based on battery capacity
get_icon() {
    [ "$battery_capacity" -gt "$WARNING_LEVEL" ] \
        && icon="battery-good" \
        && return
    [ "$battery_capacity" -gt "$CRITICAL_LEVEL" ] \
        && icon="battery-low" \
        || icon="battery-caution"
}

# Set urgency based on battery capacity
get_urgency() {
    [ "$battery_capacity" -gt "$WARNING_LEVEL" ] \
        && urgency="normal" \
        || urgency="critical"
}

# Get battery capacity
get_battery_capacity() {
    IFS= read -r battery_capacity < "$battery_dir/capacity"
}

# Get battery status
get_battery_status() {
    IFS= read -r battery_status < "$battery_dir/status"
}

# Run script in the background
while true; do
    # Update battery status
    get_battery_status
    # Match battery status
    case "$battery_status" in
        "Full")
            # Send notification if status has changed
            if is_diff_status; then
                get_battery_capacity
                icon="battery-full"
                urgency="low"
                send_notification && save_status
            fi
            ;;
        "Charging")
            # Send notification if status has changed
            if is_diff_status; then
                get_battery_capacity
                get_icon
                icon="${icon}-charging"
                urgency="normal"
                send_notification && save_status
            fi
            ;;
        "Discharging")
            # Send notification if icon has changed
            # since discharging has multiple capacity levels
            get_battery_capacity
            get_icon
            if is_diff_icon; then
                get_urgency
                send_notification && save_status && save_icon
            fi
            ;;
    esac
    # Wait interval
    sleep 30
done
