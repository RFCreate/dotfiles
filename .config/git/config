[user]
	name = 
	email = 
[filter "remove-git-user"]
	clean = "sed 's/^\\tname = .*/\\tname = /;s/^\\temail = .*/\\temail = /'"
[init]
	defaultBranch = main
[alias]
	a = add
	aa = add --all
	au = add --update
	b = branch
	bc = branch --copy
	bd = branch --delete
	bm = branch --move
	c = commit
	ca = commit -a
	cm = commit -m
	cam = commit -am
	co = checkout
	cob = checkout -b
	d = diff
	dc = diff --cached
	ds = diff --stat
	dsc = diff --stat --cached
	dw = diff --word-diff
	dwc = diff --word-diff --cached
	lg = log --oneline --decorate --graph
	pl = pull
	ps = push
	psf = push --force-with-lease --force-if-includes
	rmc = rm --cached
	s = status
	ss = status --short
	sw = switch
	swc = switch --create
	swd = switch --detach
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[pull]
	autostash = true
	rebase = true
